# DB 접속 (SQL Server). 서버 인증서 검증은 끔 — 암호화만(D-064·D-140)
DB_CONNECTION_STRING=Server=change-me;Database=change-me;User Id=change-me;Password=change-me;Encrypt=True;TrustServerCertificate=True;

# 클라이언트 종류별 API 키 (D-103)
COLLECTOR_API_KEY=change-me
DASHBOARD_API_KEY=change-me
SERVER_URL=https://+:5443/
DB_PROBE_TIMEOUT_SECONDS=2
DB_PROBE_INTERVAL_SECONDS=2
COLLECTOR_STOPPED_SECONDS=10
LOG_DIRECTORY=logs