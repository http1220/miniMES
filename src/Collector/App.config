<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <appSettings>
    <add key="PollIntervalMilliseconds" value="1000" />
    <add key="ReadTimeoutMilliseconds" value="500" />
    <add key="JudgeIntervalMilliseconds" value="1000" />
    <add key="CommunicationFaultMilliseconds" value="5000" />
    <add key="CommunicationRecoverySuccessCount" value="3" />
    <add key="ThresholdConsecutiveCount" value="3" />
    <add key="BackoffMaximumMilliseconds" value="10000" />
    <add key="BackoffMaximumJitterFraction" value="0.2" />
    <add key="SampleBufferCapacity" value="3000" />
    <add key="AlarmQueueCapacity" value="3000" />
    <add key="LogDirectory" value="" />
    <add key="HeartbeatIntervalMilliseconds" value="2000" />
    <add key="ServerStoppedSeconds" value="10" />
    <add key="HttpRequestTimeoutMilliseconds" value="5000" />
    <add key="ShutdownTimeoutMilliseconds" value="10000" />
    <add key="ClockJumpThresholdMilliseconds" value="1000" />
    <!-- Thresholds and valid ranges are examples, not measured values. -->
    <add key="Equipment.1.Host" value="127.0.0.1" />
    <add key="Equipment.1.Port" value="15021" />
    <add key="Equipment.1.UnitId" value="1" />
    <add key="Equipment.1.StartAddress" value="0" />
    <add key="Equipment.1.WordOrder" value="ABCD" />
    <add key="Equipment.1.TemperatureUpperLimit" value="80" />
    <add key="Equipment.1.VibrationUpperLimit" value="10" />
    <add key="Equipment.1.TemperatureMinimum" value="-40" />
    <add key="Equipment.1.TemperatureMaximum" value="200" />
    <add key="Equipment.1.VibrationMinimum" value="0" />
    <add key="Equipment.1.VibrationMaximum" value="100" />
